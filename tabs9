#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$(realpath "$0")")"
# One host, one systemd user unit and one status file per tablet:
# app-tabs9.<slug>.service and .local/state/host-<slug>.status.json, where
# the slug is the tablet's model (sm_x910, hmw_w09). The "app-" unit name is
# how xdg-desktop-portal learns an app id ("tabs9.<slug>") for the host: the
# KDE portal names the virtual output after it, and without one every
# virtual output is called "Virtual-virtual-xdp-kde-" and KScreen applies a
# mode meant for one tablet to both. Portal restore tokens are per app id,
# hence per tablet. TABS9_UNIT/TABS9_STATUS_FILE pin a single unit instead
# (tests, and the pre-multi-tablet layout).
unit=${TABS9_UNIT:-}
status_file=${TABS9_STATUS_FILE:-}
legacy_unit=tab-s9-usb-display.service

# The value of --tablet in "$@" (or --tablet=X), else empty.
tablet_arg() {
  local previous=''
  for word in "$@"; do
    if [[ "$previous" == '--tablet' ]]; then printf '%s' "$word"; return; fi
    if [[ "$word" == --tablet=* ]]; then printf '%s' "${word#--tablet=}"; return; fi
    previous=$word
  done
}

# Sets unit/status_file/label for the tablet named by --tablet (or the only
# one attached). Prints the reason and exits 1 when that is not exactly one.
pick_tablet() {
  local line
  selector=$(tablet_arg "$@")
  if [[ -n "$unit" ]]; then
    status_file=${status_file:-.local/state/host.status.json}
    label=${TABS9_LABEL:-tablet}
    return 0
  fi
  if ! line=$(python3 src/tablets.py choose ${selector:+--tablet "$selector"}); then
    exit 1
  fi
  slug=${line%%$'\t'*}
  label=${line#*$'\t'}
  unit="app-tabs9.$slug.service"
  status_file=".local/state/host-$slug.status.json"
}

# xdg-desktop-portal takes the app id from the unit name only when a
# matching desktop entry exists (it loads "<appid>.desktop"): a hidden one
# per tablet under ~/.local/share/applications, nothing else. It also names
# the host in KDE's dialogs. Removed by `./tabs9 forget`.
ensure_desktop_entry() {
  local dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  local file="$dir/tabs9.$slug.desktop"
  [[ -f "$file" ]] && return 0
  mkdir -p "$dir"
  cat > "$file" <<EOF_DESKTOP
[Desktop Entry]
Type=Application
Name=tabs9 ($label)
Comment=$label as a second screen over USB
Exec=$PWD/tabs9 start --tablet $slug
Icon=video-display
NoDisplay=true
Terminal=true
Categories=Utility;
EOF_DESKTOP
}

# Every instance known to systemd or by a status file: "slug" per line.
all_instances() {
  {
    systemctl --user list-units --all --plain --no-legend 'app-tabs9.*.service' 2>/dev/null \
      | awk '{print $1}' | sed -e 's/^app-tabs9\.//' -e 's/\.service$//'
    for f in .local/state/host-*.status.json; do
      [[ -f "$f" ]] || continue
      f=${f##*/host-}; printf '%s\n' "${f%.status.json}"
    done
  } | sort -u
}

# Prints "phase<US>message<US>stale" for status_file, cross-checked against
# the unit's MainPID (pass "" when the unit is not active) via
# status.status_summary. A phase is 'stale' when it cannot be trusted to
# describe the process systemd currently tracks: a leftover file from a
# different pid (e.g. ./tabs9 bench-capture, which writes the same status
# file outside systemd), a non-terminal phase left behind by a process that
# is no longer running, or a non-terminal phase old enough to be a stuck
# write rather than a genuinely long-running one.
status_line() {
  local pid="${1:-}"
  # Use \x1f (unit separator) rather than a tab: IFS classifies tab as
  # whitespace, so `IFS=$'\t' read` squeezes consecutive tabs and would
  # misalign fields whenever the message is empty.
  python3 -c '
import sys
sys.path.insert(0, "src")
from pathlib import Path
from status import status_summary
pid = int(sys.argv[2]) if sys.argv[2] else None
s = status_summary(Path(sys.argv[1]), pid)
msg = (s["message"] or "").replace("\x1f", " ").replace("\n", " ")
print((s["phase"] or "") + "\x1f" + msg + "\x1f" + ("1" if s["stale"] else "0"))
' "$status_file" "$pid" 2>/dev/null || printf '\x1f\x1f0\n'
}

# Empty string when the unit is not active (systemd reports MainPID=0 then).
unit_main_pid() {
  local pid
  pid=$(systemctl --user show --property=MainPID --value "$unit" 2>/dev/null || true)
  if [[ -z "$pid" || "$pid" == "0" ]]; then
    return 0
  fi
  printf '%s' "$pid"
}

case "${1:-help}" in
  setup) shift; exec python3 scripts/setup.py "$@" ;;
  doctor) shift; exec python3 scripts/setup.py --doctor "$@" ;;
  start)
    shift
    pick_tablet "$@"
    if systemctl --user is-active --quiet "$unit"; then
      echo "$label is already running."
      exit 0
    fi
    python3 scripts/setup.py --check
    [[ -n "${TABS9_UNIT:-}" ]] || ensure_desktop_entry
    # Clear stale status before starting
    rm -f "$status_file"
    # Settings remembered for this tablet (./tabs9 ui) go first: what is typed
    # here still wins, argparse keeps the last occurrence of an option.
    saved=()
    if [[ -z "${TABS9_UNIT:-}" ]]; then
      while IFS= read -r word; do saved+=("$word"); done < <(python3 src/settings.py args ${selector:+--tablet "$selector"})
    fi
    systemd-run --user --quiet --collect --unit="$unit" \
      --property=Type=exec --property=TimeoutStopSec=10 --property=KillMode=mixed \
      --working-directory="$PWD" /usr/bin/python3 -u "$PWD/src/host.py" "${saved[@]}" "$@"
    # Wait for the host to report its actual state (bounded timeout)
    echo 'Waiting for host to initialize...'
    timeout=60
    elapsed=0
    consent_printed=false
    while (( elapsed < timeout )); do
      # Check liveness FIRST: a status file must never be able to report
      # success (or any other stale phase) for a unit that is already gone.
      if ! systemctl --user is-active --quiet "$unit" 2>/dev/null; then
        IFS=$'\x1f' read -r phase msg _ < <(status_line "")
        if [[ "$phase" == "failed" ]]; then
          echo "✗ $label failed: $msg"
        elif [[ "$phase" == "stopped" ]]; then
          echo "✗ USB display stopped: $msg"
        else
          echo '✗ USB display service exited unexpectedly.'
        fi
        exit 1
      fi
      pid=$(unit_main_pid)
      IFS=$'\x1f' read -r phase msg stale < <(status_line "$pid")
      if [[ "$stale" == "1" ]]; then
        phase=""
      fi
      case "$phase" in
        streaming)
          # Re-check liveness immediately before declaring success, closing
          # the window between the read above and this line.
          if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
            echo "✓ $label is streaming."
            if [[ -n "$msg" ]]; then
              echo "  $msg"
            fi
            exit 0
          fi
          ;;
        failed)
          echo "✗ $label failed to start: $msg"
          exit 1
          ;;
        stopped)
          echo "✗ USB display stopped: $msg"
          exit 1
          ;;
        waiting_virtual_consent)
          if [[ "$consent_printed" == false ]]; then
            echo ''
            echo '────────────────────────────────────────────────────────'
            echo '  Two KDE consent dialogs will appear (one at a time):'
            echo ''
            echo '  1. "Share virtual screen" → creates the virtual output'
            echo '     Click "Share" to allow (prompted each start on KDE).'
            echo ''
            echo '  2. Remote-control dialog → click "Allow" (no screen to pick:'
            echo '     KDE shares every screen and the host selects the virtual'
            echo '     one). One-time if "Allow restoring" stays checked.'
            echo '────────────────────────────────────────────────────────'
            echo ''
            consent_printed=true
          fi
          ;;
        waiting_capture_consent)
          # Second dialog — just keep waiting
          ;;
      esac
      sleep 1
      (( elapsed++ )) || true
    done
    echo '⚠ Timeout waiting for host to reach streaming state.'
    echo '  The service is still running. Check: ./tabs9 status ; ./tabs9 logs'
    exit 2
    ;;
  stop)
    shift
    if [[ -n "$unit" || -n "$(tablet_arg "$@")" ]]; then
      pick_tablet "$@"
      units=("$unit")
    else
      units=("$legacy_unit")
      while read -r slug; do [[ -n "$slug" ]] && units+=("app-tabs9.$slug.service"); done < <(all_instances)
    fi
    stopped=0
    for u in "${units[@]}"; do
      if systemctl --user is-active --quiet "$u"; then
        systemctl --user stop "$u"
        echo "stopped ${u#app-tabs9.}" | sed 's/\.service$//'
        stopped=1
      fi
    done
    (( stopped )) || echo 'No tablet display was running.'
    ;;
  status)
    if [[ -z "$unit" ]]; then
      shift
      found=0
      while read -r slug; do
        [[ -n "$slug" ]] || continue
        found=1
        TABS9_UNIT="app-tabs9.$slug.service" TABS9_STATUS_FILE=".local/state/host-$slug.status.json" \
          TABS9_LABEL="$slug" "$0" status | sed "s/^USB display service/$slug/"
      done < <(all_instances)
      if systemctl --user is-active --quiet "$legacy_unit"; then
        found=1
        TABS9_UNIT="$legacy_unit" TABS9_STATUS_FILE=.local/state/host.status.json "$0" status
      fi
      (( found )) || echo 'No tablet display is running (nothing started yet).'
      exit 0
    fi
    if systemctl --user is-active --quiet "$unit"; then
      pid=$(unit_main_pid)
      IFS=$'\x1f' read -r phase msg stale < <(status_line "$pid")
      if [[ "$stale" == "1" ]]; then
        echo 'USB display service: running (status file does not match this instance)'
      elif [[ -n "$phase" ]]; then
        echo "USB display service: running (phase: $phase)"
        if [[ -n "$msg" ]]; then
          echo "  $msg"
        fi
      else
        echo 'USB display service: running'
      fi
    else
      IFS=$'\x1f' read -r phase msg stale < <(status_line "")
      if [[ "$stale" == "1" ]]; then
        echo 'USB display service: stopped (stale status left over from a previous run)'
      elif [[ "$phase" == "failed" ]]; then
        echo "USB display service: stopped (last failure: $msg)"
      else
        echo 'USB display service: stopped'
      fi
    fi
    ;;
  logs)
    shift
    if [[ -n "$unit" || -n "$(tablet_arg "$@")" ]]; then
      pick_tablet "$@"
      journalctl --user -u "$unit" --no-pager -n 30 -o cat
    else
      journalctl --user -u 'app-tabs9.*' -u "$legacy_unit" --no-pager -n 40 -o cat
    fi
    ;;
  pin-desktop)
    # Keep windows on the tablet output visible on every virtual desktop.
    case "${2:-}" in
      on)
        kpackagetool6 --type KWin/Script --install "$PWD/kwin/tabs9-pin" >/dev/null 2>&1 \
          || kpackagetool6 --type KWin/Script --upgrade "$PWD/kwin/tabs9-pin" >/dev/null
        kwriteconfig6 --file kwinrc --group Plugins --key tabs9-pinEnabled true
        gdbus call --session --dest org.kde.KWin --object-path /KWin --method org.kde.KWin.reconfigure >/dev/null
        if ! qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.isScriptLoaded tabs9-pin 2>/dev/null | grep -qx true; then
          qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript \
            "$HOME/.local/share/kwin/scripts/tabs9-pin/contents/code/main.js" tabs9-pin >/dev/null
          qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.start >/dev/null
        fi
        echo 'Windows on the tablet now stay put when you switch virtual desktops.'
        ;;
      off)
        kwriteconfig6 --file kwinrc --group Plugins --key tabs9-pinEnabled false
        # Release the pins first: main.js only remembers them in memory.
        release="$HOME/.local/share/kwin/scripts/tabs9-pin/contents/code/release.js"
        if [[ -f "$release" ]]; then
          qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$release" tabs9-pin-release >/dev/null 2>&1 \
            && qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.start >/dev/null 2>&1 || true
          qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript tabs9-pin-release >/dev/null 2>&1 || true
        fi
        qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript tabs9-pin >/dev/null 2>&1 || true
        gdbus call --session --dest org.kde.KWin --object-path /KWin --method org.kde.KWin.reconfigure >/dev/null
        echo 'Tablet windows follow virtual desktops again.'
        ;;
      status)
        if qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.isScriptLoaded tabs9-pin 2>/dev/null | grep -qx true; then
          echo 'pin-desktop: on (KWin script loaded)'
        else
          echo "pin-desktop: off (config: $(kreadconfig6 --file kwinrc --group Plugins --key tabs9-pinEnabled --default false))"
        fi
        ;;
      *) echo 'Usage: ./tabs9 pin-desktop on|off|status'; exit 1 ;;
    esac
    ;;
  ui)
    # The control panel runs as a user service so the terminal (or the
    # launcher icon) returns at once; the page is opened in the browser.
    shift
    port=${TABS9_UI_PORT:-8899}
    url="http://127.0.0.1:$port/"
    ui_up() { python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('${url}api/state', timeout=2).status == 200 else 1)" 2>/dev/null; }
    case "${1:-}" in
      --stop) systemctl --user stop app-tabs9.ui.service 2>/dev/null || true; echo 'Control panel stopped.'; exit 0 ;;
    esac
    if ! ui_up; then
      systemd-run --user --quiet --collect --unit=app-tabs9.ui.service --working-directory="$PWD" \
        /usr/bin/python3 "$PWD/src/ui.py" --port "$port"
      for _ in $(seq 1 20); do ui_up && break; sleep 0.25; done
    fi
    echo "tabs9 control panel: $url  (./tabs9 ui --stop ends it)"
    if [[ "${1:-}" != '--no-open' ]] && command -v xdg-open >/dev/null; then
      xdg-open "$url" >/dev/null 2>&1 &
    fi
    ;;
  launcher)
    # A visible desktop entry: tabs9 in the application launcher, ready to be
    # pinned to the panel (right-click it there -> "Pin to Task Manager").
    dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    mkdir -p "$dir"
    cat > "$dir/tabs9.desktop" <<EOF_DESKTOP
[Desktop Entry]
Type=Application
Name=tabs9
GenericName=Tablet as a second screen
Comment=Open the tabs9 control panel
Exec=$PWD/tabs9 ui
Icon=$PWD/docs/tabs9.svg
Terminal=false
Categories=Utility;System;
Keywords=tablet;monitor;screen;usb;display;
EOF_DESKTOP
    update-desktop-database "$dir" >/dev/null 2>&1 || true
    echo "Added 'tabs9' to the application launcher ($dir/tabs9.desktop)."
    echo 'To keep it on the panel: find it in the launcher, right-click -> Pin to Task Manager.'
    ;;
  forget)
    # Everything tabs9 put outside this directory: the desktop entries.
    rm -f "${XDG_DATA_HOME:-$HOME/.local/share}"/applications/tabs9.*.desktop \
          "${XDG_DATA_HOME:-$HOME/.local/share}"/applications/tabs9.desktop
    echo 'Removed the tabs9 desktop entries; nothing else lives outside this directory.'
    ;;
  pen-actions) shift; exec python3 scripts/kde-actions.py "$@" ;;
  shortcuts) shift; exec python3 scripts/kde-actions.py --list "$@" ;;
  test-motion) shift; exec python3 scripts/motion-test.py "$@" ;;
  bench-capture) shift; exec python3 scripts/capture_ab.py "$@" ;;
  *)
    echo 'Usage: ./tabs9 {setup [--yes] [--no-sudo] [--start]|doctor|start [options]|stop|status|logs|ui [--stop]|launcher|forget|pin-desktop on|off}'
    echo '  One host per tablet: start/stop/logs take --tablet MODEL when more than one is attached;'
    echo '  status and stop without it cover every tablet. ui opens the control panel in the browser.'
    echo '  setup walks through every requirement and fixes what it can (asks before sudo);'
    echo '  doctor runs the same checks read-only and prints the fix for each failure.'
    echo '              {pen-actions [gesture target]|shortcuts [component]}'
    echo '              {test-motion [--seconds N]|bench-capture [--seconds N]}'
    echo '  start options: --tablet MODEL  --side left|right|top|bottom'
    echo '                 --profile smooth|balanced|light (120/60/30 fps)'
    echo '                 --resolution 2960x1848  --fps 30|60|90|120'
    echo '                 --bitrate 40000  --scale 1.5  --gap 1  --capture-memory va|system|gl'
    echo '                 --scroll natural|standard|off  --scroll-gain 0.2  --gestures on|off'
    echo '                 --two-finger-tap right-click|off  --pen-button actions|launcher|off'
    echo '                 --remote on|off  --remote-edge left|right|top|bottom|none'
    echo '                 --remote-sensitivity 2.0  --air-threshold 1.5'
    echo '  bench-capture compares both capture paths under continuous motion;'
    echo '  it needs the two KDE sharing dialogs answered once per path.'
    ;;
esac
